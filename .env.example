# ============================================
# R2 (Cloudflare) Credentials
# Only needed if using --upload-target r2
# ============================================
CF_R2_ACCESS_KEY_ID=your_r2_access_key
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CF_R2_ENDPOINT_URL=
CF_R2_BUCKET_NAME=your-bucket-name

# ============================================
# Google Drive - OAuth 2.0 (RECOMMENDED)
# Use your personal Google account
# ============================================
GOOGLE_USE_OAUTH=true
GOOGLE_CLIENT_SECRET_FILE=
GOOGLE_DRIVE_FOLDER_ID=""

# ============================================
# Google Drive - Service Account (advanced)
# Only works with Shared Drive / Google Workspace
# ============================================
# GOOGLE_USE_OAUTH=false
# GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SHARED_DRIVE_ID=your_shared_drive_id
# GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id