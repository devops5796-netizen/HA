# ============================================
# R2 (Cloudflare) Credentials
# Only needed if using --upload-target r2
# ============================================
CF_R2_ACCESS_KEY_ID=your_r2_access_key
CF_R2_SECRET_ACCESS_KEY=your_r2_secret_key
CF_R2_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
CF_R2_BUCKET_NAME=your-bucket-name

# ============================================
# Google Drive Credentials
# Only needed if using --upload-target drive
# ============================================
# Option 1: Path to service account JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Option 2: Raw JSON content of service account (overrides Option 1)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Drive root folder ID (get from URL: https://drive.google.com/drive/folders/FOLDER_ID)
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id